{
  "name": "college-hoops-sim",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "sim:players": "node --import tsx scripts/inspectPlayerGeneration.ts",
    "sim:rosters": "node --import tsx scripts/inspectRosterGeneration.ts",
    "sim:rotations": "node --import tsx scripts/inspectRotationGeneration.ts",
    "sim:strength": "node --import tsx scripts/inspectTeamStrength.ts",
    "sim:games": "node --import tsx scripts/inspectGameSimulation.ts",
    "sim:boxscores": "node --import tsx scripts/inspectBoxScores.ts",
    "sim:universe": "node --import tsx scripts/inspectUniverse.ts",
    "sim:schedule": "node --import tsx scripts/inspectSchedule.ts",
    "sim:season-state": "node --import tsx scripts/inspectSeasonState.ts",
    "sim:season": "node --import tsx scripts/inspectSeason.ts",
    "sim:player-stats": "node --import tsx scripts/inspectPlayerStats.ts",
    "sim:postseason": "node --import tsx scripts/inspectPostseason.ts",
    "sim:dynasty-foundation": "node --import tsx scripts/inspectDynastyFoundation.ts",
    "sim:recruiting": "node --import tsx scripts/inspectRecruiting.ts",
    "sim:recruiting-strategy": "node --import tsx scripts/inspectRecruitingStrategy.ts",
    "sim:talent-distribution": "node --import tsx scripts/inspectTalentDistribution.ts",
    "sim:roster-rollover": "node --import tsx scripts/inspectRosterRollover.ts",
    "sim:season-rollover": "node --import tsx scripts/inspectSeasonRollover.ts",
    "sim:dynasty-long-run": "node --import tsx scripts/inspectDynastyLongRun.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "check": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.11",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
