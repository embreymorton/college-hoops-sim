    "sim:rotation-minutes-realism": "node --import tsx scripts/inspectRotationMinutesRealism.ts",
    "sim:strength": "node --import tsx scripts/inspectTeamStrength.ts",
    "sim:games": "node --import tsx scripts/inspectGameSimulation.ts",
    "sim:boxscores": "node --import tsx scripts/inspectBoxScores.ts",
    "sim:universe": "node --import tsx scripts/inspectUniverse.ts",
    "sim:schedule": "node --import tsx scripts/inspectSchedule.ts",
    "sim:season-state": "node --import tsx scripts/inspectSeasonState.ts",
    "sim:season": "node --import tsx scripts/inspectSeason.ts",
    "sim:player-stats": "node --import tsx scripts/inspectPlayerStats.ts",
    "sim:player-statistical-identity": "node --import tsx scripts/inspectPlayerStatisticalIdentity.ts",
    "sim:player-profile-specialization": "node --import tsx scripts/inspectPlayerProfileSpecialization.ts",
    "sim:player-profile-candidate-a": "node --import tsx scripts/inspectPlayerProfileRedistributionCandidateA.ts",
    "sim:player-profile-candidate-a-season": "node --import tsx scripts/inspectPlayerProfileCandidateASeason.ts",
    "sim:overall-candidate-b": "node --import tsx scripts/inspectOverallCandidateB.ts",
    "sim:overall-candidate-b-season": "node --import tsx scripts/inspectOverallCandidateBSeason.ts",
    "sim:postseason": "node --import tsx scripts/inspectPostseason.ts",
    "sim:tournament-balance": "node --import tsx scripts/inspectTournamentBalance.ts",
    "sim:dynasty-foundation": "node --import tsx scripts/inspectDynastyFoundation.ts",
