    "sim:endogenous-pot-reference": "node --import tsx scripts/inspectEndogenousPotReference.ts",
    "sim:s0-pot-candidate-a": "node --import tsx scripts/inspectS0PotCandidateA.ts",
    "sim:s0-pot-candidate-a2": "node --import tsx scripts/inspectS0PotCandidateA2.ts",
    "sim:s0-pot-candidate-a3": "node --import tsx scripts/inspectS0PotCandidateA3.ts",
    "sim:s0-pot-candidate-a4": "node --import tsx scripts/inspectS0PotCandidateA4.ts",
